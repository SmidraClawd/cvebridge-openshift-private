# Copy to .env and fill in your company values. Never commit .env.
# Values are literal data: no shell expansion, no export, no commands.
NAMESPACE=cvebridge
APP_IMAGE=registry.example.com/security/cvebridge:1.0.0-go
WEBHOOK_PUBLIC_URL=https://cvebridge.apps.CHANGE_ME
IMAGE_PULL_SECRET=
STORAGE_CLASS=
STATE_STORAGE_SIZE=1Gi

# A non-admin Mattermost bot, member of the approved PRIVATE channel.
MATTERMOST_INTERNAL_URL=https://mattermost.CHANGE_ME
MATTERMOST_BOT_USER_ID=CHANGE_ME
MATTERMOST_BOT_TOKEN=CHANGE_ME
# Token of the /cve custom slash command, created once in Mattermost.
MATTERMOST_COMMAND_TOKEN=CHANGE_ME
# Optional separately registered /acs alias; leave empty if unused.
MATTERMOST_ACS_COMMAND_TOKEN=
MATTERMOST_CHANNEL_SCOPES='{"CHANGE_ME_CHANNEL_ID":["my-team"]}'
MATTERMOST_CHANNEL_POLICIES='{"CHANGE_ME_CHANNEL_ID":"common"}'
# Stable Mattermost user IDs -> exact OpenShift usernames. No guessed groups.
MATTERMOST_KUBE_USER_MAP='{"CHANGE_ME_USER_ID":"CHANGE_ME_OPENSHIFT_USERNAME"}'
MATTERMOST_SCHEDULE_SCOPES='{"CHANGE_ME_CHANNEL_ID":["my-team"]}'
MATTERMOST_SCHEDULE_MANAGERS='{"CHANGE_ME_CHANNEL_ID":["CHANGE_ME_USER_ID"]}'
SCHEDULE_SERVICE_USER=system:serviceaccount:cvebridge:cvebridge-reporter
SCHEDULE_DEFAULT_TIMEZONE=Europe/Stockholm

# ACS/StackRox Central and the exact secured-cluster ID.
STACKROX_URL=https://central.stackrox.svc:443
STACKROX_CLUSTER_ID=CHANGE_ME
STACKROX_TOKEN=CHANGE_ME
STACKROX_SCAN_TOKEN=CHANGE_ME
STACKROX_STATUS_TOKEN=CHANGE_ME
STACKROX_SCHEDULE_TOKEN=CHANGE_ME
STACKROX_SCANNER_COMPONENT=SCANNER_V4
STACKROX_DELEGATE_SCAN=false
DATABASE_MAX_AGE_HOURS=24
# Optional local CA files; render copies their PUBLIC certificates into a ConfigMap.
STACKROX_CA_FILE=
MATTERMOST_CA_FILE=

CVE_ALERTS_ENABLED=true
CVE_ALERT_MIN_CVSS=9
CVE_ALERT_FIRST_REPORT=false
