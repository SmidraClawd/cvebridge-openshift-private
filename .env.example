# Fyll i företagsvärdena. Image, bot-ID och schemamappar räknas ut automatiskt.
# Avancerade undantag finns i .env.advanced.example. .env ska inte committas.
NAMESPACE=cvebridge
WEBHOOK_PUBLIC_URL=https://cvebridge.apps.CHANGE_ME
MATTERMOST_INTERNAL_URL=https://mattermost.CHANGE_ME
MATTERMOST_BOT_TOKEN=CHANGE_ME
MATTERMOST_COMMAND_TOKEN=CHANGE_ME
MATTERMOST_CHANNEL_ID=CHANGE_ME
SCAN_NAMESPACES=my-team
# Stabila Mattermost-ID:n -> exakta klusterkonton för alla människor i kanalen.
MATTERMOST_KUBE_USER_MAP='{"CHANGE_ME_USER_ID":"CHANGE_ME_OPENSHIFT_USERNAME"}'
STACKROX_CLUSTER_ID=CHANGE_ME
# Behåll separata token och de ACS-behörigheter respektive funktion behöver.
STACKROX_TOKEN=CHANGE_ME
STACKROX_SCAN_TOKEN=CHANGE_ME
STACKROX_STATUS_TOKEN=CHANGE_ME
STACKROX_SCHEDULE_TOKEN=CHANGE_ME
# Privat CA? Lägg publik PEM i certs/ och lägg till STACKROX_CA_FILE=certs/central-ca.pem.
