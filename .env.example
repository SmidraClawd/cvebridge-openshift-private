# Kopiera denna fil till .env manuellt. Byt CHANGE_ME mot era värden.
# Steg och exempel för varje fält: docs/ENV_VARDEN.md
# Använd KEY=värde utan yttre citattecken: oc --from-env-file läser bokstavligt.

# oc project -q visar valt projekt. Bot och PVC ska finnas där.
NAMESPACE=CHANGE_ME_NAMESPACE
# oc get pvc -n DITT_NAMESPACE -> kopiera PVC:ns NAME.
STATE_EXISTING_PVC=CHANGE_ME_PVC
# oc get projects -> välj apparnas projekt att skanna, separera med kommatecken.
SCAN_NAMESPACES=team-a

# Mattermosts vanliga HTTPS-serveradress. Boten lägger till /api/v4 själv.
# Nyckeln heter INTERNAL av kompatibilitetsskäl; adressen får vara extern.
MATTERMOST_INTERNAL_URL=https://mattermost.CHANGE_ME_DOMAIN
# Mattermost-admin: Integrations -> Bot Accounts -> skapa bot som Member -> Access Token.
MATTERMOST_BOT_TOKEN=CHANGE_ME
# Integrations -> Slash Commands -> skapa /cve med POST -> Save -> Token.
MATTERMOST_COMMAND_TOKEN=CHANGE_ME
# Öppna rapportkanalen -> Visa info / View Info (i) -> kopiera ID längst ner.
MATTERMOST_CHANNEL_ID=CHANGE_ME
# Vänster: personens Mattermost-ID från admin. Höger: samma persons oc whoami.
MATTERMOST_KUBE_USER_MAP={"CHANGE_ME_USER_ID":"CHANGE_ME_OPENSHIFT_USER"}

# ACS Centrals vanliga HTTPS-serveradress. Boten lägger till /v1 själv.
STACKROX_URL=https://central.CHANGE_ME_DOMAIN
# ACS-ansvarig: labbklustrets id från GET /v1/clusters (matcha klustrets name).
STACKROX_CLUSTER_ID=CHANGE_ME
# ACS: Platform Configuration -> Integrations -> API Token -> Generate Token.
# Rollen beskrivs i docs/ENV_VARDEN.md. Kopiera tokenen efter Generate.
STACKROX_TOKEN=CHANGE_ME

# Valfritt: privat driftkanal -> Visa info (i) -> ID; bjud in boten där.
# DATABASE_MONITOR_CHANNEL_ID=CHANGE_ME_DRIFT_CHANNEL_ID
