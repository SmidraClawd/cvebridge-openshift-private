# Byt CHANGE_ME. Service- och namespace-namn ska stämma med ert kluster.

# OpenShift
NAMESPACE=cvebridge
SCAN_NAMESPACES=team-a
# Image: image-registry.openshift-image-registry.svc:5000/<namespace>/cvebridge:<automatisk-tagg>

# Mattermost
MATTERMOST_INTERNAL_URL=http://mattermost.mattermost.svc:8065
MATTERMOST_BOT_TOKEN=CHANGE_ME
MATTERMOST_COMMAND_TOKEN=CHANGE_ME
MATTERMOST_CHANNEL_ID=CHANGE_ME
MATTERMOST_KUBE_USER_MAP='{"CHANGE_ME_USER_ID":"CHANGE_ME_OPENSHIFT_USER"}'

# ACS / StackRox
STACKROX_URL=https://central.stackrox.svc:443
STACKROX_CLUSTER_ID=CHANGE_ME
STACKROX_TOKEN=CHANGE_ME
STACKROX_SCAN_TOKEN=CHANGE_ME
STACKROX_STATUS_TOKEN=CHANGE_ME
STACKROX_SCHEDULE_TOKEN=CHANGE_ME
