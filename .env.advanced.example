# Valfria inställningar. Kopiera bara nödvändiga rader till .env och avkommentera.
# Ta inte med samma nyckel två gånger. Hemligheter ska aldrig committas.

# Automatisk image: image-registry.openshift-image-registry.svc:5000/NAMESPACE/cvebridge:go-GITREVISION
# IMAGE_TAG=1.0.0-go
# Push från en miljö som når intern DNS (Deployment använder alltid intern imageadress):
# REGISTRY_PUSH_HOST=image-registry.openshift-image-registry.svc:5000
# Push från dator utanför klustret: extern registry-route hämtas annars automatiskt.
# APP_IMAGE=annan-registry.din-doman/team/cvebridge:1.0.0
# IMAGE_PULL_SECRET=
# STORAGE_CLASS=
# STATE_STORAGE_SIZE=1Gi

# Endast om ingen färdig PVC finns och en ny nätverks-PV/PVC ska genereras:
# STATE_NETWORK_URL=//server/delning
# För NFS: nfs://server/export eller server:/export
# Med STATE_EXISTING_PVC utelämnas STATE_NETWORK_URL, STORAGE_CLASS,
# STATE_STORAGE_SIZE och alla STATE_SMB_*; befintlig lagring ändras inte.

# SMB-inloggning när STATE_NETWORK_URL anger en Windows-/SMB-delning.
# Skapar en separat Secret för lagringsdrivrutinen, inte för boten.
# STATE_SMB_USERNAME=CHANGE_ME
# STATE_SMB_PASSWORD=CHANGE_ME
# STATE_SMB_DOMAIN=CHANGE_ME
# Utan inloggningsfälten används en befintlig Secret (username, password, ev. domain):
# STATE_SMB_SECRET=cvebridge-storage
# Filernas grupp i SMB-monteringen; anpassas av plattformsteamet vid behov:
# STATE_SMB_GID=0
# STATE_NETWORK_URL och STORAGE_CLASS ska inte användas tillsammans.

# Endast om Mattermost behöver nå boten via en extern HTTPS-route:
# WEBHOOK_URL=https://cvebridge.apps.ditt-kluster.din-doman
# WEBHOOK_PUBLIC_URL stöds fortfarande som äldre namn för samma inställning.

# STACKROX_CA_FILE=certs/central-ca.pem
# MATTERMOST_CA_FILE=certs/mattermost-ca.pem
# STACKROX_SCANNER_COMPONENT=SCANNER_V4
# STACKROX_DELEGATE_SCAN=false
# MATTERMOST_BOT_USER_ID=valfritt_verifierat_bot_id
# MATTERMOST_ACS_COMMAND_TOKEN=

# Standard: gemensamma behörigheter och scheman för kanalen/namespaces i korta .env.
# Flera kanaler eller snävare scheman kan anges uttryckligen med dessa JSON-mappar.
# MATTERMOST_CHANNEL_SCOPES='{"CHANNEL_ID":["team-a"]}'
# MATTERMOST_CHANNEL_POLICIES='{"CHANNEL_ID":"common"}'
# MATTERMOST_SCHEDULE_SCOPES='{"CHANNEL_ID":["team-a"]}'
# MATTERMOST_SCHEDULE_MANAGERS='{"CHANNEL_ID":["USER_ID"]}'
# MATTERMOST_SCHEDULE_SCOPES='{}'
# SCHEDULE_SERVICE_USER=system:serviceaccount:cvebridge:cvebridge-reporter
# SCHEDULE_DEFAULT_TIMEZONE=Europe/Stockholm
# DATABASE_MAX_AGE_HOURS=24
# CVE_ALERTS_ENABLED=true
# CVE_ALERT_MIN_CVSS=9
# CVE_ALERT_FIRST_REPORT=false
