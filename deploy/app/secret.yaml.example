# Kopiera en gång: cp -n deploy/app/secret.yaml.example deploy/app/secret.yaml
# Fyll tokenvärden i secret.yaml. Den ifyllda filen ignoreras av Git.
# stringData tar vanliga tokensträngar; du behöver inte base64-koda dem.
apiVersion: v1
kind: Secret
metadata:
  name: cvebridge-tokens
type: Opaque
stringData:
  MATTERMOST_BOT_TOKEN: "CHANGE_ME_BOT_TOKEN"
  MATTERMOST_COMMAND_TOKEN: "CHANGE_ME_COMMAND_TOKEN"
  STACKROX_TOKEN: "CHANGE_ME_ACS_TOKEN"
