# Legacy-format. För ConfigMap och Secret används config-options.example.yaml.
# Valfria runtimefält. Kopiera bara nödvändiga rader till .env och avkommentera.
# KEY=värde utan yttre citattecken, även för JSON. Inga dubbla nycklar.
# Image, PVC, route och volymer redigeras i de färdiga YAML-filerna enligt README.

# Intern CA: montera CA-filerna enligt docs/INSTALLATION.md först.
# STACKROX_CA_FILE=/ca/central.pem
# MATTERMOST_CA_FILE=/ca/mattermost.pem

# Separata ACS-token är valfria undantag från grundfilens STACKROX_TOKEN.
# STACKROX_SCAN_TOKEN=CHANGE_ME
# STACKROX_STATUS_TOKEN=CHANGE_ME
# STACKROX_SCHEDULE_TOKEN=CHANGE_ME
# STACKROX_SCANNER_COMPONENT=SCANNER_V4
# STACKROX_DELEGATE_SCAN=false
# MATTERMOST_BOT_USER_ID=valfritt_verifierat_bot_id
# MATTERMOST_ACS_COMMAND_TOKEN=CHANGE_ME

# Driftläget använder MATTERMOST_CHANNEL_ID och SCAN_NAMESPACES.
# SCHEDULE_DEFAULT_TIMEZONE=Europe/Stockholm

# Driftbevakning: bjud in boten till en privat driftkanal och ange dess ID.
# DATABASE_MONITOR_CHANNEL_ID=CHANGE_ME_DRIFT_CHANNEL_ID
# DATABASE_MAX_AGE_HOURS=24
# CVE_ALERTS_ENABLED=true
# CVE_ALERT_MIN_CVSS=9
# CVE_ALERT_FIRST_REPORT=false
